# Copy this file to .env and fill in real values.
# JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the server listens on (Render sets this automatically).
PORT=3001

# Comma-separated list of allowed origins for CORS.
# In dev: http://localhost:5500,http://127.0.0.1:5500
# In prod: https://yourname.github.io
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080
